# `cp .env.example .env` 후 채우세요. .env 는 커밋되지 않습니다.
# 셸에 적용: set -a; source .env; set +a

# --- ntfy (가장 간단. 앱 설치 + 토픽 이름만) ---
# 토픽은 비밀번호나 마찬가지입니다. 남이 추측할 수 없는 긴 이름을 쓰세요.
A3_NTFY_TOPIC=

# ntfy.sh 공개 서버 대신 인증이 걸린 서버를 쓸 때만
# A3_NTFY_SERVER=https://ntfy.sh
# A3_NTFY_TOKEN=

# --- 텔레그램 (선택) ---
# A3_TELEGRAM_TOKEN=
# A3_TELEGRAM_CHAT_ID=

# --- 디스코드 (선택) ---
# A3_DISCORD_WEBHOOK=

# --- 기타 ---
# A3_CHANNELS=ntfy,console
# A3_EXAM_DATE=2027-02-06
